{
  "contract_version": "2.0.0",
  "release_stage": "MVP",
  "estado": "EN_REVISION",

  "info": {
    "title": "Contrato AI ↔ Backend",
    "description": "Contrato de interfaz entre Backend y servicio de IA para la fase request_scan, orientado a detección de sujetos y automatización de recorte de video (MVP)",
    "version": "2.0.0",
    "contact": {
      "lead": "Laura Dominguez",
      "team_ai": "Jorge Castro"
    }
  },

  "api": {
    "base_path": "/scan",

    "endpoints": {
      "POST_/scan": {
        "summary": "Iniciar análisis de detección de sujetos",
        "http_status": 201,
        "request_body": {
          "id": {
            "type": "string",
            "format": "uuid",
            "required": true
          },
          "video_url": {
            "type": "string",
            "format": "uri",
            "protocol": "https",
            "description": "URL",
            "required": true
          },
          "modo_corte": {
            "type": "string",
            "enum": ["dynamic", "center"],
            "default": "dynamic",
            "required": false
          }
        },
        "responses": {
          "201": {
            "status": "SUBIDO",
            "message": "Video recibido y en cola de espera"
          },
          "404": {
            "error_code": "VIDEO_NOT_FOUND",
            "message": "Video no encontrado o acceso denegado"
          },
          "413": {
            "error_code": "MAX_DURATION_EXCEEDED",
            "message": "El video excede los 50 segundos permitidos"
          },
          "415": {
            "error_code": "INVALID_FORMAT",
            "message": "Formato no soportado (Solo MP4, MPG, MPEG)"
          }
        }
      },

      "GET_/scan/{id}": {
        "summary": "Consultar estado del análisis",
        "path_params": {
          "id": {
            "type": "string",
            "format": "uuid",
            "required": true
          }
        },
        "responses": {
          "202": {
            "status": "PROCESANDO",
            "message": "YOLO analizando frames"
          },
          "200": {
            "status": "PROCESADO",
            "message": "Análisis completado",
            "metadata": {
              "processing_time_ms": "integer",
              "video_duration_seconds": "float",
              "frame_count": "integer"
            },
            "subjects": [
              {
                "subject_id": {
                  "type": "string"
                },
                "thumbnail_url": {
                  "type": "string",
                  "format": "uri",
                  "expires_in_seconds": 900
                }
              }
            ],
            "fallback": {
              "is_active": {
                "type": "boolean",
                "description": "true si no se detectaron sujetos"
              },
              "strategy": {
                "type": "string",
                "enum": ["CENTER_CROP"],
                "description": "Estrategia sugerida para el frontend"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "404": {
            "error_code": "JOB_NOT_FOUND",
            "message": "No existe un análisis asociado a ese id"
          }
        }
      }
    }
  },

  "security": {
    "video_url_requirements": {
      "https_only": true,
      "minimum_expiration_seconds": 300,
      "validated_domains": ["objectstorage", "blob"]
    }
  }
}